@page "/tasks"
@using Microsoft.AspNetCore.Authorization
@using TaskFlow.UI.Data
@using TaskFlow.UI.Models
@using TaskFlow.UI.Models.Authorization
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.ViewTasks)]
@inject TaskRepository TaskRepo
@inject AuthenticationStateProvider AuthStateProvider
<h3>Tasks</h3>

<AuthorizeView Policy="@Permissions.CreateTasks">

    <Authorized>
        <input @bind="newTitle" placeholder="Task title" />
        <input @bind="newDescription" placeholder="Desciption" />
        <button type="button" @onclick="CreateTasks">Create</button>
    </Authorized>
</AuthorizeView>


<hr/>

<table>
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Completed</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var task in tasks)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>
                    <input type="checkbox" checked="@task.IsCompleted" @onchange="() => ToggleComplete(task)" />
                </td>
            </tr>
        }
    </tbody>
</table>



@code {
    List<TaskItem> tasks = new();
    string newTitle = string.Empty;
    string newDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskRepo.GetAllAsync();
    }
    async Task CreateTasks()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst("userId");
        if (userIdClaim == null) throw new Exception("UserId claim missing");

        var task = new TaskItem
            {
                Title = newTitle,
                Description = newDescription,
                CreatedByUserId = MongoDB.Bson.ObjectId.Parse(userIdClaim!.Value)
            };

        await TaskRepo.CreateAsync(task);
        tasks = await TaskRepo.GetAllAsync();
        newTitle = string.Empty;
        newDescription = string.Empty;
    }
    async Task ToggleComplete(TaskItem task)
    {
        task.IsCompleted = !task.IsCompleted;
        await TaskRepo.UpdateAsync(task);
    }

}

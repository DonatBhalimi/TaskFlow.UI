@page "/manageusers"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using TaskFlow.UI.Data
@using TaskFlow.UI.Models
@using TaskFlow.UI.Models.Authorization
@inject UserRepository userRepository
@inject UserRoleService RoleService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
@inject NavigationManager Nav

<h3>ManageUsers </h3>

@if (currentUser == null || currentUser.Identity?.IsAuthenticated != true)
{
    <p>Loading...</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Assign Roles</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var user in users)
            {
                <tr>
                    <td>@user.email</td>
                    <td>@string.Join(", ", user.RoleCodes)</td>
                    <td>

                        <select @bind="user.selectedRole">
                            <option value="">--Select--</option>
                            <option value="role.superChief">Owner</option>
                            <option value="role.orgowner">Manager</option>
                        </select>
                        <button type="button" @onclick="() => SaveRole(user)"> Save </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button @onclick="GoHome" class="btn btn-primary">Home Page</button>
}
@code {
    void GoHome() => Nav.NavigateTo("/");



    List<User> users = new();
    ClaimsPrincipal? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;

        users = await userRepository.GetAllAsync();
    }
    async Task SaveRole(User user)
    {


        if (string.IsNullOrWhiteSpace(user.selectedRole))
        {
            Console.WriteLine("Role was empty.");
            return;
        }
        user.RoleCodes.Clear();

        user.RoleCodes.Add(user.selectedRole);

        await userRepository.UpdateAsync(user);
        users = await userRepository.GetAllAsync();
        StateHasChanged();

    }

    async Task AssignRole(User user, string role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return;

        await RoleService.AssignRoleAsync(user, role);

        users = await userRepository.GetAllAsync();

    }
}
